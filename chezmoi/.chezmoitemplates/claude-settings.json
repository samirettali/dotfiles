{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "sessionUrl": false
  },
  "autoMemoryEnabled": false,
  "disableClaudeAiConnectors": true,
  "disableWorkflows": true,
  "effortLevel": "medium",
  "enableArtifact": false,
  "env": {
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_IDE_SKIP_AUTO_INSTALL": "1",
    "DISABLE_AUTOUPDATER": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_FEEDBACK_COMMAND": "1",
    "ENABLE_TOOL_SEARCH": "true"
  },
  "feedbackSurveyRate": 0,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash '/Users/samir/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ]
  },
  "includeCoAuthoredBy": false,
  "model": "claude-opus-5",
  "outputStyle": "Concise",
  "permissions": {
    "defaultMode": "bypassPermissions",
    "deny": [
      "ReportFindings"
    ]
  },
  "promptSuggestionEnabled": false,
  "skillOverrides": {
    "claude-api": "user-invocable-only",
    "fewer-permission-prompts": "off",
    "init": "user-invocable-only",
    "keybindings-help": "off",
    "loop": "user-invocable-only",
    "run": "user-invocable-only",
    "schedule": "off",
    "security-review": "user-invocable-only",
    "simplify": "user-invocable-only",
    "update-config": "off"
  },
  "skipDangerousModePermissionPrompt": true,
  "spinnerTipsEnabled": false,
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "Thinking",
      "Processing",
      "Working"
    ]
  },
  "theme": "auto",
  "toolSearchEnabled": true,
  "tui": "fullscreen"
}
