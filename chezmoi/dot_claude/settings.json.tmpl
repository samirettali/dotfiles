{{- $settings := includeTemplate "claude-settings.json" . | fromJson -}}
{{- if eq .profile "work" -}}
{{-   $_ := set $settings.env "MDB_MCP_READ_ONLY" "true" -}}
{{-   $_ := set $settings "enabledPlugins" (dict
        "mongodb@claude-plugins-official" true
        "datadog@claude-plugins-official" true) -}}
{{/*  The hook script and the permission default belong to my own Mac. */}}
{{-   $_ := unset $settings "hooks" -}}
{{-   $_ := unset $settings "permissions" -}}
{{- end -}}
{{ toPrettyJson $settings }}
